[Unit]
Description=Evandro Ripka staging Node API
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/var/www/staging.evandroripka.dev
User=www-data
Group=www-data
ExecStart=/usr/bin/node /var/www/staging.evandroripka.dev/api/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
